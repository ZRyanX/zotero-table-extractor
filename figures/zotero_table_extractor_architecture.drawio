        <mxCell id="c3_cont" value="&lt;b style='font-size:13px;'&gt;Stitching &amp;amp; LLM Gate&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#115E59;'&gt;llm_reasoner.py (arXiv 2603.18652)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• MinerU 4-Way continuation check&lt;br/&gt;• DeepDoc Monotone DP alignment&lt;br/&gt;• Optional LLM repair + 3D semantic&lt;br/&gt;  equivalence verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontColor=#115E59;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col3">
