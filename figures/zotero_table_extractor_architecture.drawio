        <mxCell id="c4_xlsx" value="&lt;b style='font-size:13px;color:#166534;'&gt;🎯 Publication-Grade Excel&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#15803D;'&gt;excel_export.py (.xlsx)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;code&gt;CellRichText&lt;/code&gt; sub/superscripts&lt;br/&gt;  (&lt;code&gt;10^{-3}&lt;/code&gt;, &lt;code&gt;CaCO_3&lt;/code&gt;, &lt;code&gt;Fe^{3+}&lt;/code&gt;)&lt;br/&gt;• Autofit widths &amp;amp; QuickLook meta&lt;br/&gt;• Single-file or per-table + &lt;code&gt;_v2&lt;/code&gt; safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#166534;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col4">
