        <mxCell id="c3_post" value="&lt;b style='font-size:13px;'&gt;7-Stage Safe Post-Processing&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#115E59;'&gt;table_postprocess.py&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• SMART header flattening (&lt;code&gt;A &amp;gt; B&lt;/code&gt;)&lt;br/&gt;• Squeezed &amp;amp; multiline expansion&lt;br/&gt;• olmOCR 2 footnote isolation&lt;br/&gt;• Formula-injection &amp;amp; type guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontColor=#115E59;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col3">
