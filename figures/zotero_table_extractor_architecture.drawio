<mxfile host="app.diagrams.net" agent="drawio-mcp" version="24.0.0">
  <diagram id="zotero-table-extractor-arch" name="Zotero Table Extractor Architecture (v1.9.7)">
    <mxGraphModel dx="1700" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="860" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Top Hero Banner -->
        <mxCell id="banner" value="&lt;b style='font-size:18px;'&gt;Zotero Table Extractor — Dual-Track Architecture (v1.9.7)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#CBD5E1;'&gt;Online HTML/XML Racing  ·  Lossless Orientation &amp;amp; MinerU Primary  ·  9-Engine TEDS Voting &amp;amp; Visual AI  ·  Monotone DP &amp;amp; CellRichText Excel&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontFamily=Inter,Segoe UI,Helvetica Neue,Arial,sans-serif;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1640" height="60" as="geometry"/>
        </mxCell>

        <!-- Stage 1: Inputs & Pre-Check (x=30..305) -->
        <mxCell id="col1" value="1. Inputs &amp; Pre-Check" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;fontStyle=1;rounded=1;arcSize=4;fontFamily=Inter,Segoe UI,Helvetica Neue,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="30" y="98" width="275" height="722" as="geometry"/>
        </mxCell>
        <mxCell id="c1_in" value="&lt;b style='font-size:13px;'&gt;Multi-Source Inputs&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Zotero item / library (WAL)&lt;br/&gt;• Local or remote PDF / folder&lt;br/&gt;• Article URL, DOI, or chndoi&lt;br/&gt;• Batch path list (&lt;code&gt;.txt&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col1">
          <mxGeometry x="18" y="56" width="239" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="c1_cli" value="&lt;b style='font-size:13px;'&gt;CLI &amp;amp; Batch Dispatcher&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#475569;'&gt;extract_zotero_table · batch_run&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Subprocess pool &amp;amp; timeout&lt;br/&gt;• &lt;code&gt;--resume&lt;/code&gt; &amp;amp; &lt;code&gt;--recheck&lt;/code&gt; gate&lt;br/&gt;• Pre-2020 CN PDF-only gate&lt;br/&gt;• Remote &lt;code&gt;%PDF-&lt;/code&gt; magic check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col1">
          <mxGeometry x="18" y="271" width="239" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="c1_ori" value="&lt;b style='font-size:13px;'&gt;Tier-1 Lossless Orientation&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#475569;'&gt;doc_orientation_detector.py&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Zero-latency vector direction&lt;br/&gt;• TurboOCR (&lt;code&gt;doc_ori.onnx&lt;/code&gt;)&lt;br/&gt;• Lossless &lt;code&gt;/Rotate&lt;/code&gt; on native PDF&lt;br/&gt;• Mixed prose/table rotation guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=12;" vertex="1" parent="col1">
          <mxGeometry x="18" y="506" width="239" height="190" as="geometry"/>
        </mxCell>

        <!-- Corridor col1 -> col2: x=305..355 (50px wide) -->

        <!-- Stage 2A: Online HTML / XML Track (x=355..965) -->
        <mxCell id="col2_online" value="2A. Online HTML / XML Track (Tiered Concurrent Race)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=14;fontStyle=1;rounded=1;arcSize=4;fontFamily=Inter,Segoe UI,Helvetica Neue,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="355" y="98" width="610" height="275" as="geometry"/>
        </mxCell>
        <mxCell id="c2_tier1" value="&lt;b style='font-size:13px;'&gt;Tier 1 · XML &amp;amp; HTTP&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• arXiv HTML / ar5iv&lt;br/&gt;• NCBI PMC JATS XML&lt;br/&gt;• Elsevier XOCS (+InstToken)&lt;br/&gt;• Unpaywall DirectHTTP-first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_online">
          <mxGeometry x="18" y="54" width="176" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c2_tier23" value="&lt;b style='font-size:13px;'&gt;Tier 2/3 · Web &amp;amp; CDP&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Crawl4AI · Scrapling&lt;br/&gt;• OA-gated Firecrawl (403 CB)&lt;br/&gt;• Playwright CDP + Port Guard&lt;br/&gt;• CNKI (chndoi reroute) &amp;amp; DOM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_online">
          <mxGeometry x="217" y="54" width="176" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="c2_gate" value="&lt;b style='font-size:13px;'&gt;Completeness Gate&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Check vs. PDF ledger&lt;br/&gt;• Keep modal &amp;amp; ESM labels&lt;br/&gt;• Complete → direct export&lt;br/&gt;• Missing → PDF backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#064E3B;fontSize=12;align=left;verticalAlign=top;spacingTop=16;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_online">
          <mxGeometry x="416" y="54" width="176" height="196" as="geometry"/>
        </mxCell>

        <!-- Stage 2B: Local PDF Track (x=355..965, y=398..820) -->
        <mxCell id="col2_pdf" value="2B. Local PDF Track" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;rounded=1;arcSize=4;align=left;spacingLeft=16;fontFamily=Inter,Segoe UI,Helvetica Neue,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="355" y="398" width="610" height="422" as="geometry"/>
        </mxCell>
        <mxCell id="c2_mine" value="&lt;b style='font-size:13px;'&gt;Multi-Signal Page Mining&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#92400E;'&gt;pdf_table_extractor.py&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Full-doc Declaration Ledger&lt;br/&gt;• &lt;code&gt;pdf-inspector&lt;/code&gt; fast pre-scan&lt;br/&gt;• Native / Scanned / Mixed routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=14;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_pdf">
          <mxGeometry x="18" y="52" width="272" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="c2_prim" value="&lt;b style='font-size:13px;'&gt;Native Primary + Numeric Gate&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#92400E;'&gt;ocr_client.py · table_validator.py&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Fast-Path:&lt;/b&gt; Tagged PDF / PDF-UA tree&lt;br/&gt;• &lt;b&gt;Primary:&lt;/b&gt; MinerU (CLI + REST / flash)&lt;br/&gt;• Local bidirectional numeric check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=14;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_pdf">
          <mxGeometry x="320" y="52" width="272" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="c2_vote" value="&lt;b style='font-size:13px;'&gt;9-Engine TEDS Voting Fallback&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#92400E;'&gt;pdf-inspector · PyMuPDF4LLM · find_tables&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• GMFT · img2table · Camelot · pdfplumber&lt;br/&gt;• RapidTable · text_alignment&lt;br/&gt;• IoU + IBM TEDS (&amp;ge; 0.75) consensus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBBF24;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingTop=14;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_pdf">
          <mxGeometry x="18" y="242" width="272" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="c2_ai" value="&lt;b style='font-size:13px;'&gt;3-Stage Visual AI Takeover&lt;/b&gt;&lt;br/&gt;&lt;i style='color:#9A3412;'&gt;Anti-regression guarded OCR&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• ① RapidTable (ONNX) fast rescue&lt;br/&gt;• ② DocLayout-YOLO + PP-DocLayoutV3&lt;br/&gt;  → PaddleOCR-VL-1.6 / TeleOCR&lt;br/&gt;• ③ IBM Docling (TableFormer) offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontSize=12;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=10;" vertex="1" parent="col2_pdf">
          <mxGeometry x="320" y="242" width="272" height="156" as="geometry"/>
        </mxCell>

